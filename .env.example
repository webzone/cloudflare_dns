#
# This file is auto-loaded when present (dotenv syntax); values already set in
# the environment win over the file.

# Cloudflare auth: use a scoped API token (recommended):
CLOUDFLARE_API_TOKEN=
# ...or the legacy global key (dev fallback only; rotate to a token):
CLOUDFLARE_API_EMAIL=
CLOUDFLARE_API_KEY=

# MariaDB (the Cloudflare mirror)
MYSQL_HOST=192.168.2.246
MYSQL_PORT=3306
MYSQL_USER=domain
MYSQL_PASSWORD=
MYSQL_DB=domain

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Safety override: CF_DDNS_DRY_RUN=1 forces --dry-run behavior on every run
CF_DDNS_DRY_RUN=

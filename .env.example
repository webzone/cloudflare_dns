# cfddns runtime configuration. The Cloudflare API token does NOT need to go
# here — run `cfddns token set` and it is stored owner-only automatically.
#
# This file is auto-loaded when present (dotenv syntax); values already set in
# the environment win over the file.

#CLOUDFLARE_API_TOKEN=
CFDDNS_DB=./cfddns.db
LOG_LEVEL=info
#CF_DDNS_DRY_RUN=1

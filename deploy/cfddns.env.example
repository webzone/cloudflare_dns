# cfddns runtime configuration — copy into /etc/cfddns/cfddns.env (root, 0600)
# or ~/.cfddns.env. NEVER commit real secrets.

# scoped Cloudflare API token (preferred)
CLOUDFLARE_API_TOKEN=
# legacy global key fallback (prefer the token):
#CLOUDFLARE_API_EMAIL=
#CLOUDFLARE_API_KEY=

# SQLite mirror file (standalone; default ./cfddns.db)
CFDDNS_DB=/var/lib/cfddns/cfddns.db

LOG_LEVEL=info
#CF_DDNS_DRY_RUN=1

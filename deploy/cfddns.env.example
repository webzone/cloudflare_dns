# cfddns runtime configuration. The Cloudflare API token does NOT need to go
# here — run `cfddns token set` and it is stored owner-only automatically.
# Set variables here only when you want to override the defaults.

# Optional: token override (usually managed via `cfddns token set`)
#CLOUDFLARE_API_TOKEN=

# SQLite database file (standalone; default ./cfddns.db)
CFDDNS_DB=/var/lib/cfddns/cfddns.db

LOG_LEVEL=info
#CF_DDNS_DRY_RUN=1

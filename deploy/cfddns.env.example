# /etc/cfddns/cfddns.env — root:root 0600, loaded by systemd EnvironmentFile.
# Same keys as .env.example. Generate a scoped Cloudflare API token with:
#   Zone.Zone:Read, Zone.DNS:Edit, Zone.Cache:Purge, Zone.Settings:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_EMAIL=
CLOUDFLARE_API_KEY=

MYSQL_HOST=192.168.2.246
MYSQL_PORT=3306
MYSQL_USER=domain
MYSQL_PASSWORD=
MYSQL_DB=domain

LOG_LEVEL=info

[Unit]
Description=cfddns purge edge cache (all zones; or pass a zone name)
Documentation=https://github.com/webzone/cloudflare_dns
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
Group=user
ExecStart=/usr/local/bin/cfddns purge
EnvironmentFile=/etc/cfddns/cfddns.env
StandardOutput=append:/var/log/cfddns/cfddns.log
StandardError=append:/var/log/cfddns/cfddns.log
TimeoutStartSec=120
